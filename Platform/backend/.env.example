# ============================================================
# RoboMemo Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values for production.
# NEVER commit .env to version control.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── JWT Authentication ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-hex-secret-in-production

# ─── Encryption (AES-256-GCM) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 hex characters = 256 bits
ENCRYPTION_MASTER_KEY=

# ─── VLM API Keys (server-side, NOT client-side) ────────────
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ─── Geo-Fencing ─────────────────────────────────────────────
# Comma-separated blocked country codes (ISO 3166-1 alpha-2)
BLOCKED_COUNTRIES=CN,HK
# Allowed egress regions for VLM API calls
ALLOWED_EGRESS_REGIONS=ap-southeast-1,me-south-1,eu-west-1

# ─── CORS Allowed Origins ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://platform.robomemo.io

# ─── Database ─────────────────────────────────────────────────
# SQLite (dev) — path relative to backend/
SQLITE_PATH=data/robomemo.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://robomemo_app:password@db-sg.robomemo.io:5432/robomemo?sslmode=require

# ─── Object Storage (production) ─────────────────────────────
# S3_BUCKET=robomemo-videos-sg
# S3_REGION=ap-southeast-1
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Ollama (local VLM) ──────────────────────────────────────
OLLAMA_URL=http://localhost:11434
